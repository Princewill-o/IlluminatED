# Optional — see README
NEXT_PUBLIC_SITE_URL=https://illumed.co.uk
OPEN_LIBRARY_CONTACT=
NEXT_PUBLIC_CORRECTIONS_EMAIL=

# IlluminatEDSocial (Supabase). Leave blank to run Social in preview mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe Premium subscriptions. Use sandbox keys for development and a restricted
# live key in production. Never expose the secret or webhook key to the browser.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_CALLBACK_SECRET=

# Optional education integrations — server-side only, never NEXT_PUBLIC.
# Obtain a curriculum API key from Oak National Academy.
OAK_API_KEY=
# Obtain an unfiltered Display Advert API subscription from the apprenticeship service.
APPRENTICESHIPS_API_KEY=

# Publisher script only — never exposed to browsers. Supabase migration must be applied first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# UK jobs search: request a Jobseeker API key at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
